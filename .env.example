APP_NAME=MatchdayAPI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Configuration (MySQL 8)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=matchday_api
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=matchday_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# API Configuration
API_VERSION=v1
API_PREFIX=api

# Sanctum Configuration
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SANCTUM_GUARD=api
SANCTUM_EXPIRATION=null

# CORS Configuration
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=*
CORS_ALLOWED_HEADERS=*
CORS_EXPOSED_HEADERS=
CORS_MAX_AGE=0
CORS_SUPPORTS_CREDENTIALS=false

# Rate Limiting
RATE_LIMIT_AUTHENTICATED=60
RATE_LIMIT_GUEST=30

# Scout Configuration
SCOUT_DRIVER=database

# Image Configuration
IMAGE_DRIVER=gd

# OAuth Configuration
# Google OAuth - Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
# All accepted client IDs (web, iOS, Android) for ID-token verification.
# Comma-separated, no spaces. Falls back to GOOGLE_CLIENT_ID if unset.
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple.
# Native identity-token flow (Flutter sends Apple's identityToken, backend
# verifies it): ONLY the audience is required. For a native iOS app that is
# the app's bundle ID (e.g. com.fares.tab3); for web it is the Services ID.
APPLE_CLIENT_ID=
# Comma-separated list of every accepted audience (bundle ID + web Services
# ID). No spaces. Falls back to APPLE_CLIENT_ID if unset.
APPLE_CLIENT_IDS=
# The following are ONLY needed for the server-side auth-code / web token
# exchange flow (not the native identity-token verification above). Leave
# blank unless you implement that flow.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

VITE_APP_NAME="${APP_NAME}"

# Railway Deployment
DATABASE_URL=
REDIS_URL=
